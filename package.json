{
  "name": "mini-erp",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "node --watch-path=src/server src/server/server.ts",
    "start": "node src/server/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "contract:update": "node scripts/contract-update.ts",
    "pos:mirror": "node scripts/pos-mirror.ts",
    "release:tag": "node scripts/tag-release.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "@tanstack/query-core": "^5.103.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "hardwired": "1.6.2",
    "preact": "^10.29.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^3.0.5"
  }
}
