# /etc/mini-erp/env: entorno del servicio (lo crea provision.sh la primera vez). Sin secretos.
NODE_ENV=production
PORT=4100
DATA_DIR=/var/lib/mini-erp
BACKUP_DIR=/var/lib/mini-erp-backups
PUBLIC_URL=https://__SITE_ADDRESS__
DEMO_SESSIONS=on
DEMO_TTL_HOURS=24
DEMO_MAX_ACTIVE=200
# Hora argentina (0 a 23) del reinicio total automático de los comercios demo (#24)
DEMO_RESET_HOUR=4
DEMO_RATE_LIMIT=10
AUTH_RATE_LIMIT=20
