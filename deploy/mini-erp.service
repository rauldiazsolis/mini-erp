[Unit]
Description=mini-erp (Connector API, admin y alta)
# La base es el PostgreSQL local (socket Unix): arranca después y se reinicia con él
Requires=postgresql.service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=minierp
Group=minierp
WorkingDirectory=/opt/mini-erp/current
EnvironmentFile=/etc/mini-erp/env
ExecStart=/usr/bin/node src/server/server.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
# Solo lectura: los datos están en PostgreSQL y el servicio no escribe archivos
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
